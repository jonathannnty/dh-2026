# Production environment template — fill in real values, never commit this file
PORT=3001
NODE_ENV=production
DEMO_MODE=false

# ── Database (Neon PostgreSQL) ─────────────────────────────────────────────────
# Use a production Neon project (separate from your dev project)
DATABASE_URL=

# ── Agent service ──────────────────────────────────────────────────────────────
# Leave empty to activate deterministic fallback (safe for demo without Python service)
AGENT_SERVICE_URL=

# DeepSeek API key — only needed if AGENT_SERVICE_URL is set and points to a live instance
DEEPSEEK_API_KEY=

# ── OAuth — Google ─────────────────────────────────────────────────────────────
# Add production redirect URI in Google Console:
#   https://<your-api-domain>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth — GitHub ─────────────────────────────────────────────────────────────
# Add production callback URL in GitHub OAuth app:
#   https://<your-api-domain>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Auth ────────────────────────────────────────────────────────────────────────
# REQUIRED in production — use a different secret than dev
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Production frontend URL (used for OAuth post-login redirect)
APP_URL=https://your-frontend-domain.vercel.app
