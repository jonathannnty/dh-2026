# Test-only environment overrides for `npm test` (api workspace).
#
# Copy to api/.env.test (gitignored) and point DATABASE_URL at a DEDICATED Neon
# branch. The API suite is destructive — the ops/db-admin tests wipe the
# sessions table — so it must NOT target your dev or production database.
#
# Precedence (see api/vitest.setup.ts):
#   real env (CI secrets) > .env.test > .env
#
# Any key not set here falls back to api/.env.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
