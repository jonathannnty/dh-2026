# ── Core ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
DEMO_MODE=false

# ── Database (Neon PostgreSQL) ─────────────────────────────────────────────────
# Create a free project at https://console.neon.tech
# Copy the connection string from Dashboard → Connection Details → Connection string
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=

# After setting DATABASE_URL, push the schema once:
#   npm run db:generate --workspace api
#   npx drizzle-kit push  (from api/ directory)

# ── Python agent service (DeepSeek) ───────────────────────────────────────────
# Points to the running agent_service.py process
AGENT_SERVICE_URL=http://localhost:8000

# API key for DeepSeek (https://platform.deepseek.com)
# Set this before starting agent_service.py:
#   export DEEPSEEK_API_KEY=sk-...
#   python agent_service.py
DEEPSEEK_API_KEY=

# ── OAuth — Google ─────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add Authorized redirect URI: http://localhost:3001/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth — GitHub ─────────────────────────────────────────────────────────────
# 1. Go to https://github.com/settings/applications/new
# 2. Set Homepage URL: http://localhost:5173
# 3. Set Authorization callback URL: http://localhost:3001/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Auth ────────────────────────────────────────────────────────────────────────
# Random 32+ character secret for signing JWT cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In development, a hardcoded fallback is used if this is omitted — change for production.
JWT_SECRET=

# Base URL of the frontend (used for OAuth redirects after login)
APP_URL=http://localhost:5173
